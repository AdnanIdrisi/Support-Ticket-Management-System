# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/support_ticket_system

# JWT Authentication
JWT_SECRET=replace_with_a_strong_random_secret_key
JWT_EXPIRES_IN=7d

# Optional Admin Seed Script (npm run seed:admin --prefix server)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# Email Notifications (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Helpdesk Support <no-reply@helpdesk.local>"
